datasource db {
  provider = "mysql"
  
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUM TANIMLARI
// ======================================================

enum NoteLayer {
  TOP
  HEART
  BASE
}

enum SeasonEnum {
  Spring
  Summer
  Autumn
  Winter
  AllSeasons
}

enum OccasionEnum {
  CasualEveryday
  OfficeSafe
  DateNight
  GalaFormal
  SignatureScent
}

// ======================================================
// KULLANICI VE GÜVENLİK MODELİ
// ======================================================

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  username     String         @unique
  passwordHash String
  role         String         @default("USER") // USER veya ADMIN
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reviews      Review[]
  favorites    UserFavorite[]
  wardrobe     UserWardrobe[]
  lists        UserList[]

  @@map("users")
}

// ======================================================
// MASTER NOTA MODELİ (TR / EN)
// ======================================================

model Note {
  id        Int           @id @default(autoincrement())
  nameEn    String        @unique
  nameTr    String        @unique
  category  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  perfumes  PerfumeNote[]

  @@map("notes")
}

// ======================================================
// PARFÜM ANA MODELİ
// ======================================================

model Perfume {
  id                String             @id
  brand             String
  name              String
  gender            String
  concentration     String
  mainDescriptionEn String?            @db.Text
  mainDescriptionTr String             @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  notes             PerfumeNote[]
  seasons           PerfumeSeason[]
  occasions         PerfumeOccasion[]
  olfactoryProfile  OlfactoryProfile?
  reviews           Review[]
  favoritedBy       UserFavorite[]
  wardrobedBy       UserWardrobe[]
  listItems         UserListItem[]

  @@map("perfumes")
}

// ======================================================
// İLİŞKİ TABLOLARI (JUNCTIONS)
// ======================================================

model PerfumeNote {
  id        Int       @id @default(autoincrement())
  perfumeId String
  noteId    Int
  layer     NoteLayer

  perfume   Perfume   @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, noteId, layer])
  @@map("perfume_notes")
}

model PerfumeSeason {
  id        Int        @id @default(autoincrement())
  perfumeId String
  season    SeasonEnum

  perfume   Perfume    @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, season])
  @@map("perfume_seasons")
}

model PerfumeOccasion {
  id        Int          @id @default(autoincrement())
  perfumeId String
  occasion  OccasionEnum

  perfume   Perfume      @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, occasion])
  @@map("perfume_occasions")
}

model OlfactoryProfile {
  id        Int     @id @default(autoincrement())
  perfumeId String  @unique
  sweet     Int     @default(0)
  spicy     Int     @default(0)
  floral    Int     @default(0)
  fresh     Int     @default(0)
  woody     Int     @default(0)

  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@map("olfactory_profiles")
}

// ======================================================
// YORUMLAR, FAVORİLER VE GARDIROP
// ======================================================

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId String
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
  @@map("user_favorites")
}

model UserWardrobe {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId String
  status    String   // "OWNED", "WANT", "HAD" vb.
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
  @@map("user_wardrobes")
}

// ======================================================
// KULLANICI ÖZEL LİSTELERİ (USER LISTS)
// ======================================================

model UserList {
  id          Int            @id @default(autoincrement())
  userId      Int
  title       String
  description String?        @db.Text
  isPublic    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       UserListItem[]

  @@map("user_lists")
}

model UserListItem {
  id        Int      @id @default(autoincrement())
  listId    Int
  perfumeId String
  addedAt   DateTime @default(now())

  list      UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([listId, perfumeId])
  @@map("user_list_items")
}